#include <Wire.h>
#include <MPU6050.h>
#include <Adafruit_MLX90614.h>

MPU6050 mpu;
Adafruit_MLX90614 mlx = Adafruit_MLX90614();

#define ACS712_PIN 34
#define GREEN_LED 32
#define RED_LED 33
#define MOTOR_IN1 25
#define MOTOR_IN2 26
#define MOTOR_ENA 27

// Thresholds
#define VIBRATION_THRESHOLD 2.5
#define TEMP_THRESHOLD 45.0
#define CURRENT_THRESHOLD 3.0

void setup() {
  Serial.begin(115200);
  Wire.begin();
  mpu.initialize();
  mlx.begin();

  pinMode(GREEN_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(MOTOR_IN1, OUTPUT);
  pinMode(MOTOR_IN2, OUTPUT);
  pinMode(MOTOR_ENA, OUTPUT);

  // Start motor
  digitalWrite(MOTOR_IN1, HIGH);
  digitalWrite(MOTOR_IN2, LOW);
  analogWrite(MOTOR_ENA, 180); // Speed 0-255
  
  Serial.println("System Started...");
}

void loop() {
  // Read vibration
  int16_t ax, ay, az;
  mpu.getAcceleration(&ax, &ay, &az);
  
  // Normalize accelerometer values (MPU6050 default: ±2g range, 16384 LSB/g)
  float ax_normalized = ax / 16384.0;
  float ay_normalized = ay / 16384.0;
  float az_normalized = az / 16384.0;
  
  float vibration = sqrt(ax*ax + ay*ay + az*az) / 16384.0;

  // Read temperature
  float temperature = mlx.getObjectTempC();

  // Read current
  int rawCurrent = analogRead(ACS712_PIN);
  float voltage = (rawCurrent / 4095.0) * 3.3;
  float current = (voltage - 2.5) / 0.185;

  // Print to Serial Monitor with individual axes for CNN model
  Serial.print("AX: "); Serial.print(ax_normalized, 4);
  Serial.print(" | AY: "); Serial.print(ay_normalized, 4);
  Serial.print(" | AZ: "); Serial.print(az_normalized, 4);
  Serial.print(" | Vibration: "); Serial.print(vibration, 4);
  Serial.print(" | Temp: "); Serial.print(temperature, 2);
  Serial.print("°C | Current: "); Serial.println(current, 4);

  // Fault detection logic
  if (vibration > VIBRATION_THRESHOLD || 
      temperature > TEMP_THRESHOLD || 
      current > CURRENT_THRESHOLD) {
    digitalWrite(RED_LED, HIGH);
    digitalWrite(GREEN_LED, LOW);
    Serial.println("⚠️ FAULT DETECTED!");
  } else {
    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);
    Serial.println("✅ Machine Healthy");
  }

  delay(1000);
}
